#!/bin/sh

set -e
MVNW_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_VERSION=3.9.11
MAVEN_HOME_DIR="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_BIN="${MAVEN_HOME_DIR}/apache-maven-${MAVEN_VERSION}/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
  ARCHIVE="${MAVEN_HOME_DIR}/apache-maven-${MAVEN_VERSION}-bin.zip"
  mkdir -p "$MAVEN_HOME_DIR"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$URL" -o "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$URL" -O "$ARCHIVE"
  else
    echo "curl ou wget e necessario para baixar o Maven." >&2
    exit 1
  fi
  (cd "$MAVEN_HOME_DIR" && jar xf "$ARCHIVE")
  chmod +x "$MAVEN_BIN"
  rm -f "$ARCHIVE"
fi

exec "$MAVEN_BIN" -f "$MVNW_DIR/pom.xml" "$@"
